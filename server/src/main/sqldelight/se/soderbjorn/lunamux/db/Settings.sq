CREATE TABLE IF NOT EXISTS settings (
    key   TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS pane_scrollback (
    leaf_id    TEXT NOT NULL PRIMARY KEY,
    bytes      BLOB NOT NULL,
    updated_at INTEGER NOT NULL,
    cols       INTEGER,
    rows       INTEGER
);

CREATE TABLE IF NOT EXISTS agent_sessions (
    id                  TEXT NOT NULL PRIMARY KEY,
    agent               TEXT NOT NULL,
    agent_session_id    TEXT,
    source              TEXT NOT NULL,
    leaf_id             TEXT,
    terminal_session_id TEXT,
    cwd                 TEXT,
    repo                TEXT,
    branch              TEXT,
    worktree_path       TEXT,
    title               TEXT,
    first_prompt        TEXT,
    transcript_path     TEXT,
    links               TEXT NOT NULL DEFAULT '',
    state               TEXT NOT NULL,
    state_since         INTEGER NOT NULL,
    now_line            TEXT,
    question            TEXT,
    last_screen         TEXT,
    created_at          INTEGER NOT NULL,
    ended_at            INTEGER,
    repo_root           TEXT,
    search_text         TEXT,
    last_said           TEXT,
    task_id             TEXT,
    background          INTEGER NOT NULL DEFAULT 0
);

-- Every task the server keeps something about, any task id (an agent-made task or a task file's).
-- A task file declares its own repo, open command and (when it has one) title, so none of those is
-- stored for it: `title` is set only for a task an agent made, and is what tells the two apart.
-- main_conversation is the agent's own conversation id of the conversation that speaks for the
-- task, never a pane: pane ids are handed out again on every start. status and status_at are the
-- task's one-line status; question_waits is 1 while that status says a question waits for the
-- person and is set and cleared together with it. started_at is the time the task was first
-- recorded: its first session's start, else its file's time, else the moment a status or main
-- conversation was first set; the first stamp wins, so a task's place in the overview never moves.
-- created_at and updated_at are the times an agent made and last renamed the task. Every column
-- but id can be empty: a task that has only been named has no start yet, and a task file's task has
-- no creation time.
CREATE TABLE IF NOT EXISTS tasks (
    id                TEXT NOT NULL PRIMARY KEY,
    title             TEXT,
    main_conversation TEXT,
    status            TEXT,
    status_at         INTEGER,
    question_waits    INTEGER,
    started_at        INTEGER,
    created_at        INTEGER,
    updated_at        INTEGER
);

-- The blocks agents write into a task's panel, any task id (an agent-made task or a task file's).
-- `position` is the order the blocks are drawn in; `body` is the block's content as JSON and
-- `kind` repeats its type name for anyone reading the table by hand.
CREATE TABLE IF NOT EXISTS task_panel_blocks (
    task_id    TEXT NOT NULL,
    block_id   TEXT NOT NULL,
    position   INTEGER NOT NULL,
    kind       TEXT NOT NULL,
    title      TEXT,
    body       TEXT NOT NULL,
    written_by TEXT,
    written_at INTEGER NOT NULL,
    PRIMARY KEY (task_id, block_id)
);

selectByKey:
SELECT value FROM settings WHERE key = ?;

upsert:
INSERT OR REPLACE INTO settings(key, value) VALUES (?, ?);

deleteByKey:
DELETE FROM settings WHERE key = ?;

selectScrollback:
SELECT bytes, cols, rows FROM pane_scrollback WHERE leaf_id = ?;

upsertScrollback:
INSERT OR REPLACE INTO pane_scrollback(leaf_id, bytes, updated_at, cols, rows) VALUES (?, ?, ?, ?, ?);

deleteScrollback:
DELETE FROM pane_scrollback WHERE leaf_id = ?;

selectAllScrollbackLeafIds:
SELECT leaf_id FROM pane_scrollback;

upsertAgentSession:
-- search_text is written only by setAgentSessionSearchText. INSERT OR REPLACE
-- deletes the old row first, so the sub-select carries the stored text over.
INSERT OR REPLACE INTO agent_sessions(
    id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, search_text, last_said, task_id, background
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?,
    (SELECT search_text FROM agent_sessions WHERE id = ?), ?, ?, ?);

-- The hot reads below name their columns so the long search_text never rides
-- along; imported history (source = 'import') is only ever found by search.
selectRecentEndedAgentSessions:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE state = 'ended' AND source != 'import' AND ended_at >= ?
ORDER BY ended_at DESC LIMIT ?;

selectAgentSessionByAgentId:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE agent = ? AND agent_session_id = ? ORDER BY created_at DESC LIMIT 1;

selectAgentSessionByConversation:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE agent_session_id = ? ORDER BY created_at DESC LIMIT 1;

selectAgentSessionById:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE id = ?;

selectOpenAgentSessions:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE state != 'ended';

-- Close one record at the time it was last known to be alive, not at the time it was found closed.
endAgentSessionAt:
UPDATE agent_sessions SET state = 'ended', ended_at = :endedAt, state_since = :endedAt WHERE id = :id;

-- A screen record that a hook later named, and whose conversation already had a record, is
-- dropped: the older record carries on in its place.
deleteAgentSession:
DELETE FROM agent_sessions WHERE id = ?;

setAgentSessionSearchText:
UPDATE agent_sessions SET search_text = ? WHERE id = ?;

selectAgentSessionsMissingSearchText:
SELECT id, transcript_path FROM agent_sessions
WHERE state = 'ended' AND transcript_path IS NOT NULL AND search_text IS NULL;

-- Every record whose title, first prompt, branch, links, transcript text or last
-- screen contains :raw (LIKE, with :pattern already escaped by the caller).
-- The two big columns come back only as a short window around the first match.
-- A background session (one an agent runs out of sight) is never found, live or closed.
searchAgentSessions:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, created_at, ended_at, repo_root, last_said, task_id, background,
    CASE WHEN search_text LIKE :pattern ESCAPE '\'
        THEN substr(search_text, max(1, instr(lower(search_text), lower(:raw)) - 80), 240) END AS transcript_window,
    CASE WHEN last_screen LIKE :pattern ESCAPE '\'
        THEN substr(last_screen, max(1, instr(lower(last_screen), lower(:raw)) - 80), 240) END AS screen_window
FROM agent_sessions
WHERE background = 0 AND (
    title LIKE :pattern ESCAPE '\'
    OR first_prompt LIKE :pattern ESCAPE '\'
    OR branch LIKE :pattern ESCAPE '\'
    OR links LIKE :pattern ESCAPE '\'
    OR search_text LIKE :pattern ESCAPE '\'
    OR last_screen LIKE :pattern ESCAPE '\')
ORDER BY COALESCE(ended_at, state_since) DESC
LIMIT 200;

-- Every record stored with one of :taskIds, however old, for search by task title.
-- The caller keeps :taskIds short (the tasks whose title matched the query).
selectAgentSessionsByTaskIds:
SELECT id, agent, agent_session_id, source, leaf_id, terminal_session_id, cwd, repo, branch,
    worktree_path, title, first_prompt, transcript_path, links, state, state_since, now_line,
    question, last_screen, created_at, ended_at, repo_root, last_said, task_id, background
FROM agent_sessions WHERE background = 0 AND task_id IN :taskIds
ORDER BY COALESCE(ended_at, state_since) DESC
LIMIT 200;

-- A task has no members of its own: a session belongs to it through agent_sessions.task_id.
selectTasks:
SELECT id, title, main_conversation, status, status_at, question_waits, started_at, created_at, updated_at
FROM tasks ORDER BY COALESCE(created_at, started_at), id;

-- A task an agent makes; its id is new. A row that exists is left as it is, never replaced, so
-- what is stored about a task is never wiped.
insertTask:
INSERT OR IGNORE INTO tasks(id, title, created_at, updated_at) VALUES (?, ?, ?, ?);

renameTask:
UPDATE tasks SET title = ?, updated_at = ? WHERE id = ?;

-- A row for a task that has none yet, so something can be stored about it; changes nothing when
-- the task has one.
ensureTask:
INSERT OR IGNORE INTO tasks(id) VALUES (?);

-- The first stamp wins: a task's place in the overview must not move once it has one.
stampTaskStart:
UPDATE tasks SET started_at = ? WHERE id = ? AND started_at IS NULL;

setTaskMainConversation:
UPDATE tasks SET main_conversation = ? WHERE id = ?;

setTaskStatus:
UPDATE tasks SET status = ?, status_at = ?, question_waits = ? WHERE id = ?;

selectTaskPanelBlocks:
SELECT task_id, block_id, position, kind, title, body, written_by, written_at
FROM task_panel_blocks ORDER BY task_id, position;

upsertTaskPanelBlock:
INSERT OR REPLACE INTO task_panel_blocks(task_id, block_id, position, kind, title, body, written_by, written_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteTaskPanelBlock:
DELETE FROM task_panel_blocks WHERE task_id = ? AND block_id = ?;

deleteTaskPanel:
DELETE FROM task_panel_blocks WHERE task_id = ?;
